include("lib/http.bzg");

var server = http(8000);

// ==========================================
// HTTP EVENT HANDLERS
// ==========================================
server.get = function (path, data) {
    print("get loc:" + path);

    if (path == "/") {
        server.sendFile("public/index.html");
    } else if (path == "../images/heads.png") {
        server.sendFile("images/heads.png");
    } else if (path == "../images/tails.png") {
        server.sendFile("images/tails.png");
    } else {
        server.sendFile("public/404.html");
    }

};

// ==========================================
// WEBSOCKET (WS) EVENT HANDLERS
// ==========================================

// Triggered when a client successfully connects via wss://
server.onConnect = function (clientId) {
   print("WebSocket connected! Client ID: " + clientId);
  
   // Send a welcome message to this specific client
   server.send(clientId, "Welcome toWebSocket server!");
};
var visitors = 0;
server.onConnect = function (clientId) {
   visitors = visitors + 1;
   server.sendAll("visitors:" + visitors);
};
// Triggered when a client sends a message
server.onData = function (message, clientId) {
   print("Received from Client " + clientId + ": " + message);

   if(message == "ping"){
      server.send(clientId, "pong from BSL");
   }
   else if(message == "whoami"){
      server.send(clientId, "You are client " + clientId);
   }
  else if (message == "coin:Heads" || message == "coin:Tails") {
        server.sendAll(message);
   }
else { server.sendAll("User " + clientId + " says: " + message);
    }
};



// Triggered when a client disconnects
server.onDisconnect = function (clientId) {
     visitors = visitors - 1;
   server.sendAll("visitors:" + visitors);
   print("WebSocket disconnected! Client ID: " + clientId);
};

server.run();
